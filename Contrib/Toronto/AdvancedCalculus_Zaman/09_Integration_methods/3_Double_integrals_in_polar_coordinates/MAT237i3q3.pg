##DESCRIPTION
##  Algebra problem: true or false for inequality
##ENDDESCRIPTION

##KEYWORDS('algebra', 'inequality', 'fraction')

## DBsubject('Algebra')
## DBchapter('Fundamentals')
## DBsection('Real Numbers')
## Date('6/3/2002')
## Author('')
## Institution('')
## TitleText1('Precalculus')
## EditionText1('3')
## AuthorText1('Stewart, Redlin, Watson')
## Section1('1.1')
## Problem1('22')

DOCUMENT();

loadMacros(
    'PGstandard.pl', 'PGML.pl', 'parserPopUp.pl', 'plots.pl',
    'PGcourse.pl'
);

$plot[0] = Plot(
    xmin        => -2.5,
    xmax        =>  2.5,
    xtick_delta =>  1,
    xminor      =>  1,
    ymin        => -2.5,
    ymax        =>  2.5,
    ytick_delta =>  1,
    yminor      =>  1,
);
$plot[0]->add_function([ '(1+cos(2t))*cos(t)', '(1+cos(2t))*sin(t)' ],
    't', 0, '2pi', color => 'darkred');

$plot[1] = Plot(
    xmin        => -20,
    xmax        =>  20,
    xtick_delta =>  5,
    xminor      =>  4,
    ymin        => -20,
    ymax        =>  20,
    ytick_delta =>  5,
    yminor      =>  4,
);
$plot[1]
    ->add_function([ 't*cos(t)', 't*sin(t)' ], 't', 0, 30, color => 'darkred');
$plot[2] = Plot(
    xmin        => -0.5,
    xmax        =>  3.5,
    xtick_delta =>  1,
    xminor      =>  1,
    ymin        => -2.5,
    ymax        =>  2.5,
    ytick_delta =>  1,
    yminor      =>  1,
);
$plot[2]->add_function([ '(1+2cos(t))*cos(t)', '(1+2cos(t))*sin(t)' ],
    't', 0, '2pi', color => 'darkred');

$plot[3] = Plot(
    xmin        => -1.5,
    xmax        =>  1.5,
    xtick_delta =>  1,
    xminor      =>  1,
    ymin        => -1.5,
    ymax        =>  1.5,
    ytick_delta =>  1,
    yminor      =>  1,
);
$plot[3]->add_function([ 'sin(3t)*cos(t)', 'sin(3t)*sin(t)' ],
    't', 0, '2pi', color => 'darkred');

@dd = map { DropDown([ 'A' .. 'F' ], $_) } (2, 0, 5, 4);

$showPartialCorrectAnswers = 0;

BEGIN_PGML
Here is a list of six equations in polar coordinates.

[#
    [. *A* .] [. [`r=\theta, \; \theta > 0 `] .]
    [. *B* .] [. [`r=\theta, \; \theta < 0 `] .]
    [. *C* .] [. [`r= 1+ \cos(2\theta)`] .]*
    [. *D* .] [. [`r=\cos(3\theta) `] .]
    [. *E* .] [. [`r=\sin(3\theta) `] .]
    [. *F* .] [. [`r=1+2 \cos(\theta)`] .]*
    #]{padding => [0.25,0.75]}

For each plot, match to the corresponding polar equation: 

[#
    [.[!!]{$plot[0]}{200}.][.[!!]{$plot[1]}{200}.]*
    [. [_]{$dd[0]} .][. [_]{$dd[1]} .]*
    [.[!!]{$plot[2]}{200}.][.[!!]{$plot[3]}{200}.]*
    [. [_]{$dd[2]} .][. [_]{$dd[3]} .]*
#]{padding => [0.25, 0.75]}

END_PGML

ENDDOCUMENT();
