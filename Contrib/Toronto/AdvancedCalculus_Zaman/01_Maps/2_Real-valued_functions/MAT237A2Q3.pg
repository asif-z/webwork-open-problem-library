##DESCRIPTION
##  Contour plot basics problem, MAT237 A2 worksheet Q3
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'contour plot', 'real-valued functions’)

## DBsubject('Multivariable Calculus')
## DBchapter('Fundamentals')
## DBsection('Real-valued functions')
## Date('9/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('A2')
## Problem1('3')

DOCUMENT();

loadMacros(
    'PGstandard.pl', 'PGML.pl', 'parserPopUp.pl', 'PGgraders.pl',
    'PGcourse.pl'
);

@surf = (
    'a2-surface1.png', 'a2-surface2.png',
    'a2-surface3.png', 'a2-surface4.png'
);
@cont = (
    'a2-contour1.png', 'a2-contour2.png',
    'a2-contour3.png', 'a2-contour4.png'
);

@shuffle = random_subset(4, 0 .. 3);
@inv[@shuffle] = 0 .. 3;                     # define the inverse

@dd = map { DropDown([ 'A' .. 'D' ], $_) } (0 .. 3);

install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [ 2,   4 ];
$ENV{'grader_scores'}   = [ 0.5, 1 ];
$ENV{'grader_message'} =
    "You can earn " . "50% partial credit for 2 - 3 correct answers.";

$showPartialCorrectAnswers = 0;

BEGIN_PGML
A contour plot for a function [` f: \mathbb{R}^2\to\mathbb{R} `] is a finite collection of level sets plotted on a single plane. Match the contour plot to the graph of the function.

[#
    [.[!!]{$surf[0]}{200}.][.[!!]{$surf[1]}{200}.]
    [.[!!]{$surf[2]}{200}.] [.[!!]{$surf[3]}{200}.]*
    [. [_]{$dd[$inv[0]]} .][. [_]{$dd[$inv[1]]} .]
    [. [_]{$dd[$inv[2]]} .][. [_]{$dd[$inv[3]]} .]*
    [.[!!]{$cont[$shuffle[0]]} .][.[!!]{$cont[$shuffle[1]]} .]
    [.[!!]{$cont[$shuffle[2]]} .][.[!!]{$cont[$shuffle[3]]} .]*
    [. *A* .][. *B* .] [. *C* .] [. *D* .]*
#]


END_PGML

BEGIN_PGML_SOLUTION
If you can imagine slices through the surface plots, then you will see the contour plots.  In this case

1) Surface plot corresponds to Contour plot [$dd[$shuffle[0]]].
2) Surface plot corresponds to Contour plot [$dd[$shuffle[1]]].
3) Surface plot corresponds to Contour plot [$dd[$shuffle[2]]].
4) Surface plot corresponds to Contour plot [$dd[$shuffle[3]]].
END_PGML_SOLUTION
COMMENT("Uses static graphs");

ENDDOCUMENT();
