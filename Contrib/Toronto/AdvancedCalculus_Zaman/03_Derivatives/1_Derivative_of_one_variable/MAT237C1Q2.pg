##DESCRIPTION
##  Derivatives problem, MAT237 C1 worksheet Q2
##ENDDESCRIPTION

##KEYWORDS('multivariable calculus', 'derivatives')

## DBsubject('Multivariable Calculus')
## DBchapter('Derivatives')
## DBsection('Derivatives of one variable')
## Date('10/7/2023')
## Author('')
## Institution('University of Toronto')
## TitleText1('MAT237 Worksheets')
## EditionText1('')
## AuthorText1('')
## Section1('C1')
## Problem1('2')

DOCUMENT();

loadMacros('PGstandard.pl', 'PGML.pl', 'parserPopUp.pl', 'PGgraders.pl', 'PGcourse.pl');

Context("Numeric");

$dd_opts = ['Equivalent', 'Not equivalent'];

$dd1 = DropDown($dd_opts,0);
$dd2 = DropDown($dd_opts,0);
$dd3 = DropDown($dd_opts,1);
$dd4 = DropDown($dd_opts,1);
$dd5 = DropDown($dd_opts,0);

$showPartialCorrectAnswers = 0;

#  Incremental grader

install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{'grader_numright'} = [1,2,3,4,5];
$ENV{'grader_scores'} = [0.2,0.4,0.6,0.8,1];
$ENV{'grader_message'} = "You can earn partial credits.";


BEGIN_PGML
Let [` f: \mathbb{R}\to\mathbb{R}^m `] and let [`a\in\mathbb{R}`]. Which of the following are equivalent to "[`f`] is differentiable at [`a`]"?
  
a) [_]{$dd1} The limit [`` \lim_{h\to0}\frac{f(a+h)-f(a)}{h} ``] exists.
  
b) [_]{$dd2} There exists a linear map [`` L: \mathbb{R}\to\mathbb{R}^m ``] such that [`` \lim_{h\to0}\frac{f(a+h)-f(a)-L(h)}{h}=0 ``].
  
c) [_]{$dd3} There exists a linear map [`` L: \mathbb{R}\to\mathbb{R}^m ``] such that [`` \lim_{h\to0}\frac{f(a+h)-L(h)}{h}=0 ``].
  
d) [_]{$dd4} There exists a linear map [`` L: \mathbb{R}\to\mathbb{R}^m ``] such that [`` \big|\lim_{h\to0}\frac{f(a+h)f(a)-L(h)}{h}\big|=0 ``].
  
d) [_]{$dd5} There exists a linear map [`` L: \mathbb{R}\to\mathbb{R}^m ``] such that [`` \big|\big|\lim_{h\to0}\frac{f(a+h)f(a)-L(h)}{h}\big|\big|=0 ``].
END_PGML


BEGIN_PGML_SOLUTION

a) [$dd1]
b) [$dd2]
c) [$dd3]
d) [$dd4]
e) [$dd5]

END_PGML_SOLUTION

COMMENT('MathObject version.');

ENDDOCUMENT();